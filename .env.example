# ICAPeg Business Logic Configuration
# Copy this file to .env and fill in your values

# Tenant ID (set on ICAP server; proxy does not send tenant ID)
TENANT_ID=98fe190c-ea20-4c50-9d2c-e9766495da5e

# Region code (optional) - e.g. us-east, eu. Sent in SQS payload; backend resolves to region_id for request/user segregation.
# Set per ICAP deployment so each location sends its region code.
# REGION_CODE=us-east

# Database Configuration (PostgreSQL) — must match the backend DB so ai_tool_endpoints is visible to ICAPeg.
# Format: postgresql://user:password@host:port/database?sslmode=disable
# Local backend + ICAP on host: localhost. ICAP in Docker / Postgres on host: host.docker.internal (Windows/Mac Docker Desktop).
DATABASE_URL=postgresql://user:password@localhost:5432/icapdb?sslmode=disable

# Same queue URL as backend RECORDING_QUEUE_URL (recording worker polls here).
# AWS SQS Configuration — optional for URL matching, required to enqueue captures.
RECORDING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/048367016430/urai-recording-queue-sudeep

# AWS Region (default: us-east-1)
AWS_REGION=ap-south-1

# AWS Credentials (Optional - can use IAM roles instead)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
